  }
  var act = t.getAttribute && t.getAttribute("data-act");
  if(act){
    var en = t.closest(".entry"), id = en.getAttribute("data-id"), list = P().days[viewDate] || [];
    var idx = list.findIndex(function(e){return e.id===id;});
    if(idx<0) return;
