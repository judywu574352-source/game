/* ====== 圖片處理 ====== */
function readImage(file){
  return new Promise(function(resolve, reject){
    var url = URL.createObjectURL(file), img = new Image();
    img.onload = function(){
      try{
        function scaled(maxSide, q){
          var w = img.naturalWidth, h = img.naturalHeight, r = Math.min(1, maxSide/Math.max(w,h));
          var cv = document.createElement("canvas"); cv.width = Math.round(w*r); cv.height = Math.round(h*r);
          cv.getContext("2d").drawImage(img,0,0,cv.width,cv.height);
          return cv.toDataURL("image/jpeg", q);
        }
        var out = {api: scaled(1280,0.82), thumb: scaled(220,0.6)};
        URL.revokeObjectURL(url); resolve(out);
      }catch(e){ URL.revokeObjectURL(url); reject(e); }
    };
    img.onerror = function(){ URL.revokeObjectURL(url); reject(new Error("無法讀取這張照片，請換一張或改用文字描述。")); };
    img.src = url;
  });
}

/* ====== AI 判斷 ====== */
function buildSystemPrompt(){
  var prof = P();
  var isBulk = prof.goal === "bulk";
  var goalInstruction = isBulk
    ? "【使用者目標：健康增重與增肌】此使用者偏瘦需要增加熱量盈餘與蛋白質。若今日熱量尚未達標，請鼓勵並具體推薦高營養密度、容易達成熱量目標的台灣常見食物（例如無糖豆漿加堅果、香蕉、全脂鮮奶、茶葉蛋、地瓜、雞腿便當加飯），避免空熱量垃圾食物。"
    : "【使用者目標：減脂與體重控制】此使用者需要控制熱量赤字並維持高蛋白以防肌肉流失。請特別留意醬汁、油炸麵衣、精緻澱粉與含糖飲料的隱形熱量，並推薦台灣超商或便當店容易取得的低卡高蛋白搭配（如無糖豆漿、茶葉蛋、舒肥雞胸、關東煮白蘿蔔與高麗菜捲）。";

  return "你是熟悉台灣飲食的專業營養師助理。使用者會提供一餐的照片和／或文字描述，請估算熱量與三大營養素。\n"+
  goalInstruction + "\n" +
  "規則：\n"+
  "1. 以台灣常見份量與烹調方式估算（便當、小吃、手搖飲預設中杯全糖正常冰）；文字補充（份量、甜度、去皮、少飯等）優先於照片推測。\n"+
  "2. 逐項列出食物並各自給熱量，total_kcal 必須等於各項加總。\n"+
  "3. 若看不出份量，用常見份量估計，並把 confidence 設為「低」或「中」。\n"+
  "4. 若內容不是食物或飲料，items 設為空陣列、各數值為 0，advice 說明無法判斷。\n"+
  "5. advice 用繁體中文、2 到 4 句，必須結合「今日已攝取」、「每日熱量目標」與「每日蛋白質目標」，給出這餐的點評與下一餐具體搭配建議。語氣溫和像貼心夥伴，不說教。\n"+
  "6. 只輸出一個 JSON 物件，不要 markdown、不要任何其他文字。格式：\n"+
  '{"items":[{"name":"食物名","portion":"份量","kcal":數字}],"total_kcal":數字,"protein_g":數字,"carbs_g":數字,"fat_g":數字,"confidence":"高|中|低","advice":"建議文字"}';
}

function dayContext(){
  var prof = P(), es = dayEntries(viewDate), t = totals(es);
  var tg = num(prof.target) || 1800, proTg = num(prof.proTarget) || 100;
  var modeName = prof.goal === "bulk" ? "增重增肌模式" : "減脂減重模式";
  var parts = SLOTS.map(function(s){
    var k = totals(es.filter(function(e){return e.slot===s.id;})).kcal;
    return k>0 ? s.name+" "+round(k) : null;
  }).filter(Boolean);
  return "目前模式："+modeName+"。今日已攝取：共 "+round(t.kcal)+" 大卡（蛋白質 "+round(t.p)+" g、碳水 "+round(t.c)+" g、脂肪 "+round(t.f)+" g）"+
         (parts.length?"；各餐："+parts.join("、"):"；目前尚無其他紀錄")+
         "。每日目標：熱量 "+tg+" 大卡、蛋白質 "+proTg+" g。";
}

function parseResult(text){
  var m = text.match(/\{[\s\S]*\}/);
  if(!m) throw new Error("AI 回覆格式無法解析，請再試一次。");
  var o = JSON.parse(m[0]);
  var items = Array.isArray(o.items) ? o.items.map(function(i){ return {name:String(i.name||"食物"), portion:i.portion?String(i.portion):"", kcal:round(i.kcal)}; }) : [];
  var total = round(o.total_kcal);
  if(items.length){ var s = items.reduce(function(a,i){return a+i.kcal;},0); if(!total || Math.abs(s-total)>Math.max(20,total*0.1)) total = s; }
  return {items:items, kcal:total, p:num(o.protein_g), c:num(o.carbs_g), f:num(o.fat_g), conf:o.confidence?String(o.confidence):"", advice:o.advice?String(o.advice):""};
}

async function callAI(slot){
  var key = (localStorage.getItem(KEY_API)||"").trim();
  if(!key) throw new Error("尚未設定 API 金鑰。請按右上角「設定」貼上金鑰。");
  var model = (localStorage.getItem(KEY_MODEL)||DEFAULT_MODEL).trim() || DEFAULT_MODEL;
  var d = drafts[slot], sName = SLOTS.filter(function(s){return s.id===slot;})[0].name;
  var content = [];
  if(d.img){ content.push({type:"image", source:{type:"base64", media_type:"image/jpeg", data:d.img.api.split(",")[1]}}); }
  content.push({type:"text", text:"餐別：「"+sName+"」\n"+(d.text.trim()?"文字說明："+d.text.trim():"（沒有文字說明，請依照片判斷）")+"\n"+dayContext()});
  var ctrl = new AbortController(), timer = setTimeout(function(){ctrl.abort();}, 60000);
  var res;
  try{
    res = await fetch("https://api.anthropic.com/v1/messages",{
      method:"POST", signal:ctrl.signal,
      headers:{"content-type":"application/json","x-api-key":key,"anthropic-version":"2023-06-01","anthropic-dangerous-direct-browser-access":"true"},
      body:JSON.stringify({model:model, max_tokens:1200, system:buildSystemPrompt(), messages:[{role:"user", content:content}]})
    });
  }catch(e){
    clearTimeout(timer);
    if(e.name==="AbortError") throw new Error("AI 回應逾時，請再試一次。");
    throw new Error("連不上 AI 服務，請檢查網路。");
  }
  clearTimeout(timer);
  if(!res.ok){
    var msg = ""; try{ var j = await res.json(); msg = j.error && j.error.message ? j.error.message : ""; }catch(e){}
    if(res.status===401) throw new Error("API 金鑰不正確，請到「設定」重新貼上。");
    if(res.status===404) throw new Error("找不到這個模型名稱，請到「設定」檢查模型名稱。"+(msg?"（"+msg+"）":""));
    if(res.status===429) throw new Error("使用太頻繁，請稍後再試。");
    if(res.status===400 && /credit|balance/i.test(msg)) throw new Error("API 帳戶餘額不足，請到 Anthropic 後台儲值。");
    throw new Error("AI 服務錯誤（"+res.status+"）"+(msg?"："+msg:""));
  }
  var data = await res.json();
  var text = (data.content||[]).filter(function(b){return b.type==="text";}).map(function(b){return b.text;}).join("\n");
  return parseResult(text);
}

async function runEstimate(slot){
  var d = drafts[slot];
  if(d.busy) return;
  if(!d.text.trim() && !d.img){ d.err = "請拍一張照片，或用文字描述吃了什麼。"; renderSlots(); return; }
  d.busy = true; d.err = ""; renderSlots();
  var dateAtStart = viewDate, profAtStart = S.current;
  try{
    var r = await callAI(slot);
    var e = {id:Date.now().toString(36)+Math.random().toString(36).slice(2,6), slot:slot, time:twTime(), text:d.text.trim(), thumb:d.img?d.img.thumb:"",
      kcal:r.kcal, p:r.p, c:r.c, f:r.f, items:r.items, conf:r.conf, advice:r.advice};
    var prof = S.profiles[profAtStart];
    if(!prof.days[dateAtStart]) prof.days[dateAtStart] = [];
    prof.days[dateAtStart].push(e);
    save();
    d.text = ""; d.img = null; d.err = "";
  }catch(err){
    d.err = err.message || "發生未知錯誤，請再試一次。";
  }
  d.busy = false; renderAll();
}

