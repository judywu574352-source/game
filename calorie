      if(confirm("確定刪除這筆紀錄？")){ list.splice(idx,1); if(!list.length) delete P().days[viewDate]; save(); renderAll(); }
    }else if(act==="fix"){
      var v = prompt("輸入修正後的熱量（大卡）", round(list[idx].kcal));
      if(v!==null && v.trim()!=="" && isFinite(Number(v)) && Number(v)>=0){
        var ratio = list[idx].kcal > 0 ? (Number(v) / list[idx].kcal) : 1;
        list[idx].kcal = Math.round(Number(v));
        list[idx].p = Math.round(list[idx].p * ratio * 10)/10;
        list[idx].c = Math.round(list[idx].c * ratio * 10)/10;
        list[idx].f = Math.round(list[idx].f * ratio * 10)/10;
        save(); renderAll();
      }
    }else if(act==="half"){
      var otherKey = S.current==="a"?"b":"a";
      var otherProf = S.profiles[otherKey];
      var orig = list[idx];
      if(!confirm("要將這筆餐點的一半（約 "+round(orig.kcal/2)+" 大卡）同時分給「"+otherProf.name+"」，並將自己這筆改為一半嗎？")) return;
      orig.kcal = round(orig.kcal/2);
      orig.p = Math.round(orig.p*5)/10;
      orig.c = Math.round(orig.c*5)/10;
      orig.f = Math.round(orig.f*5)/10;
      orig.text = (orig.text ? orig.text+"（共食一半）" : "共食一半");
      var copy = JSON.parse(JSON.stringify(orig));
      copy.id = Date.now().toString(36)+Math.random().toString(36).slice(2,6);
      copy.advice = "從 "+P().name+" 分享的共食餐點。";
      if(!otherProf.days[viewDate]) otherProf.days[viewDate] = [];
      otherProf.days[viewDate].push(copy);
      save(); renderAll();
    }
    return;
  }

  // settings buttons
  if(t.id==="setClose"){ settingsOpen=false; renderSettings(); }
  else if(t.id==="setSave"){
    var k = document.getElementById("setKey").value.trim(), m = document.getElementById("setModel").value.trim();
    try{
      if(k) localStorage.setItem(KEY_API,k); else localStorage.removeItem(KEY_API);
      localStorage.setItem(KEY_MODEL, m||DEFAULT_MODEL);
    }catch(e){ alert("無法儲存設定，請確認瀏覽器沒有開啟無痕模式。"); return; }
    S.profiles.a.name = document.getElementById("setNameA").value.trim()||"我";
    S.profiles.a.goal = document.getElementById("setGoalA").value;
    S.profiles.a.target = Math.max(500, Number(document.getElementById("setTgtA").value)||1500);
    S.profiles.a.proTarget = Math.max(20, Number(document.getElementById("setProA").value)||95);

    S.profiles.b.name = document.getElementById("setNameB").value.trim()||"先生";
    S.profiles.b.goal = document.getElementById("setGoalB").value;
    S.profiles.b.target = Math.max(500, Number(document.getElementById("setTgtB").value)||2500);
    S.profiles.b.proTarget = Math.max(20, Number(document.getElementById("setProB").value)||130);
    save(); settingsOpen=false; renderAll();
  }
  else if(t.id==="setShareB"){
    var curKey = (document.getElementById("setKey").value || localStorage.getItem(KEY_API) || "").trim();
    if(!curKey){ alert("請先在上方填入 Anthropic API 金鑰並按「儲存設定」，再複製連結。"); return; }
    var baseUrl = location.origin + location.pathname;
    var shareUrl = baseUrl + "#who=b&key=" + encodeURIComponent(curKey);
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(shareUrl).then(function(){
        alert("已複製「"+S.profiles.b.name+"」專屬設定連結！\n直接透過 LINE 傳給他點擊開啟，就會自動設定完成。");
      }).catch(function(){ prompt("請手動全選複製以下連結傳給對方：", shareUrl); });
    } else {
      prompt("請手動全選複製以下連結傳給對方：", shareUrl);
    }
  }
  else if(t.id==="setExport"){
    var blob = new Blob([JSON.stringify(S)],{type:"application/json"}), a = document.createElement("a");
    a.href = URL.createObjectURL(blob); a.download = "飲食記錄備份_"+todayStr+".json";
    document.body.appendChild(a); a.click(); a.remove(); setTimeout(function(){URL.revokeObjectURL(a.href);},2000);
  }
  else if(t.id==="setImport"){ document.getElementById("importFile").click(); }
});

document.addEventListener("input", function(ev){
  var t = ev.target;
  if(t.getAttribute && t.getAttribute("data-role")==="text"){
    var slot = t.closest(".composer").getAttribute("data-slot");
    drafts[slot].text = t.value;
  }
});

document.addEventListener("toggle", function(ev){
  var d = ev.target;
  if(d.classList && d.classList.contains("slot")) openSlots[d.getAttribute("data-slot")] = d.open;
}, true);

document.addEventListener("change", async function(ev){
  var t = ev.target;
  if(t.getAttribute && t.getAttribute("data-role")==="file"){
    var slot = t.closest(".composer").getAttribute("data-slot"), f = t.files && t.files[0];
    if(!f) return;
    try{ drafts[slot].img = await readImage(f); drafts[slot].err = ""; }
    catch(e){ drafts[slot].err = e.message || "照片讀取失敗"; }
    renderSlots();
  }
  else if(t.id==="jumpDate"){
    var v = t.value;
    if(/^\d{4}-\d{2}-\d{2}$/.test(v)){ viewDate = v>todayStr ? todayStr : v; renderAll(); }
  }
  else if(t.id==="importFile"){
    var file = t.files && t.files[0]; if(!file) return;
    var reader = new FileReader();
    reader.onload = function(){
      try{
        var obj = JSON.parse(reader.result);
        if(!obj || !obj.profiles || !obj.profiles.a || !obj.profiles.b) throw new Error("bad");
        if(!confirm("匯入會覆蓋這支裝置目前的所有紀錄，確定嗎？")) return;
        S = obj; save(); settingsOpen=false; renderAll();
      }catch(e){ alert("這個檔案不是正確的備份檔。"); }
    };
    reader.readAsText(file);
  }
});

/* ====== 時鐘與跨日（台灣 00:00 自動換日） ====== */
function tick(){
  var nowD = twToday();
  if(nowD!==todayStr){
    var following = (viewDate===todayStr);
    todayStr = nowD;
    if(following) viewDate = todayStr;
    openSlots = {}; openSlots[nowSlot()] = true;
    renderAll();
  } else {
    document.getElementById("clock").textContent = "台灣時間 "+twTime();
  }
}
setInterval(tick, 15000);
document.addEventListener("visibilitychange", function(){ if(!document.hidden) tick(); });
window.addEventListener("pageshow", tick);

renderAll();
</script>
</body>
</html>
