<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="雙人飲食記錄">
<title>每日飲食熱量記錄（減脂／增重雙模式）</title>
<style>
:root{
  --ink:#16302b; --ink2:#4d625d; --paper:#f6f7f3; --card:#ffffff; --line:#dde3dc;
  --leaf:#2e8b6a; --leaf-soft:#dff0e6; --sun:#e69d24; --sun-soft:#fdf3d6; --warn:#c0392b; --warn-soft:#fbe5e1;
  --blue:#2980b9; --blue-soft:#e1f0fa;
  --shadow:0 1px 2px rgba(22,48,43,.08);
}
@media (prefers-color-scheme: dark){
  :root{ --ink:#e8f0ec; --ink2:#a5b8b1; --paper:#0f1a18; --card:#172623; --line:#2a3d39;
    --leaf:#4cc59a; --leaf-soft:#1b3a31; --sun:#f2b84b; --sun-soft:#3a3115; --warn:#ff8a7a; --warn-soft:#3b1f1b;
    --blue:#5dade2; --blue-soft:#1a3242; --shadow:none; }
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);
  font-family:"Noto Sans TC","PingFang TC","Microsoft JhengHei",system-ui,-apple-system,sans-serif;
  line-height:1.55;padding:env(safe-area-inset-top) 0 calc(env(safe-area-inset-bottom) + 40px)}
.wrap{max-width:640px;margin:0 auto;padding:12px 14px}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,textarea:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--leaf);outline-offset:2px}

.topbar{display:flex;align-items:center;justify-content:space-between;gap:8px}
.who{display:flex;gap:6px}
.who button{border:1.5px solid var(--line);background:var(--card);border-radius:999px;padding:6px 14px;font-weight:600;display:flex;align-items:center;gap:5px}
.who button.on{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.badge{font-size:11px;padding:1px 6px;border-radius:99px;font-weight:700}
.badge.cut{background:var(--leaf-soft);color:var(--leaf)}
.badge.bulk{background:var(--blue-soft);color:var(--blue)}
.who button.on .badge.cut{background:var(--leaf);color:#fff}
.who button.on .badge.bulk{background:var(--blue);color:#fff}
.iconbtn{border:1.5px solid var(--line);background:var(--card);border-radius:10px;padding:6px 12px}

.datebar{margin:14px 0 6px;display:flex;align-items:baseline;justify-content:space-between;gap:8px;flex-wrap:wrap}
.datebar h1{margin:0;font-size:22px;letter-spacing:.02em}
.datebar .clock{color:var(--ink2);font-size:14px}
.pastbanner{background:var(--sun-soft);border:1.5px solid var(--sun);border-radius:12px;padding:8px 12px;margin:8px 0;display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:14px}
.pastbanner button{border:0;background:var(--ink);color:var(--paper);border-radius:8px;padding:5px 12px;font-weight:600}

.summary-wrap{background:var(--card);border:1.5px solid var(--line);border-radius:18px;padding:16px;box-shadow:var(--shadow)}
.summary{display:grid;grid-template-columns:136px 1fr;gap:14px;align-items:center}
.ring{position:relative;width:136px;height:136px}
.ring svg{width:136px;height:136px;transform:rotate(-90deg)}
.ring .num{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.ring .big{font-size:32px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
.ring .sub{font-size:12px;color:var(--ink2);margin-top:4px}
.macros{display:grid;gap:8px}
.macro{font-size:13px}
.macro .row{display:flex;justify-content:space-between}
.bar{height:7px;background:var(--line);border-radius:99px;overflow:hidden;margin-top:3px}
.bar i{display:block;height:100%;background:var(--leaf);border-radius:99px;transition:width .3s}
.bar.pro i{background:var(--blue)}
.tgt{font-size:13px;color:var(--ink2);margin-top:2px}
.over{color:var(--warn);font-weight:700}
.under{color:var(--sun);font-weight:700}
.ok{color:var(--leaf);font-weight:700}

.weight-bar{margin-top:12px;padding-top:10px;border-top:1px dashed var(--line);display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:13px}
.weight-bar .w-in{display:flex;align-items:center;gap:6px}
.weight-bar input{width:76px;border:1.5px solid var(--line);border-radius:8px;padding:4px 8px;background:var(--paper);color:var(--ink);font:inherit;font-weight:700;text-align:center}
.weight-bar button{border:1.5px solid var(--line);background:var(--paper);border-radius:8px;padding:4px 10px;font-size:12px;font-weight:600}

.slot{background:var(--card);border:1.5px solid var(--line);border-radius:16px;margin-top:12px;overflow:hidden;box-shadow:var(--shadow)}
.slot.now{border-color:var(--sun);box-shadow:0 0 0 3px var(--sun-soft)}
.slot>summary{list-style:none;display:flex;align-items:center;justify-content:space-between;padding:12px 14px;cursor:pointer;font-weight:700}
.slot>summary::-webkit-details-marker{display:none}
.slot .nowtag{background:var(--sun);color:#3a2d00;border-radius:99px;font-size:11px;padding:1px 8px;margin-left:8px;font-weight:700}
.slot .sk{color:var(--ink2);font-weight:600;font-variant-numeric:tabular-nums}
.slotbody{padding:0 14px 14px}

.entry{border-top:1px dashed var(--line);padding:12px 0}
.entry:first-child{border-top:0}
.ehead{display:flex;gap:10px}
.thumb{width:64px;height:64px;border-radius:10px;object-fit:cover;flex:none;background:var(--line)}
.etitle{flex:1;min-width:0}
.etitle .t{font-size:13px;color:var(--ink2)}
.etitle .d{font-size:15px;word-break:break-word}
.ekcal{font-size:20px;font-weight:800;white-space:nowrap;font-variant-numeric:tabular-nums}
.ekcal small{font-size:12px;font-weight:600;color:var(--ink2)}
.items{margin:8px 0 0;padding:0;list-style:none;font-size:13px;color:var(--ink2)}
.items li{display:flex;justify-content:space-between;gap:8px;padding:2px 0}
.mini{font-size:12px;color:var(--ink2);margin-top:4px}
.advice{background:var(--leaf-soft);border-radius:12px;padding:10px 12px;margin-top:8px;font-size:14px}
.advice.bulk{background:var(--blue-soft)}
.advice b{display:block;margin-bottom:2px}
.eactions{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
.eactions button{border:1.5px solid var(--line);background:transparent;border-radius:8px;padding:4px 10px;font-size:12px;color:var(--ink2)}
.eactions button.share-btn{border-color:var(--leaf);color:var(--leaf);font-weight:600}

.composer{border-top:1px dashed var(--line);padding-top:12px;margin-top:4px}
.composer textarea{width:100%;min-height:64px;border:1.5px solid var(--line);border-radius:10px;padding:8px 10px;background:var(--paper);color:var(--ink);font:inherit;font-size:15px;resize:vertical}
.pickrow{display:flex;gap:8px;align-items:center;margin:8px 0;flex-wrap:wrap}
.pick{border:1.5px dashed var(--leaf);color:var(--leaf);border-radius:10px;padding:8px 14px;font-weight:700;background:transparent}
.preview{position:relative}
.preview img{width:72px;height:72px;object-fit:cover;border-radius:10px;display:block}
.preview button{position:absolute;top:-6px;right:-6px;width:22px;height:22px;border-radius:50%;border:0;background:var(--ink);color:var(--paper);font-size:13px;line-height:22px;padding:0}
.go{width:100%;border:0;background:var(--leaf);color:#fff;border-radius:12px;padding:12px;font-weight:800;font-size:16px}
.go[disabled]{opacity:.55;cursor:wait}
.err{background:var(--warn-soft);color:var(--warn);border-radius:10px;padding:8px 10px;margin-top:8px;font-size:14px}

.hist{margin-top:22px}
.hist h2{font-size:17px;margin:0 0 8px}
.chart{display:flex;align-items:flex-end;gap:4px;height:95px;background:var(--card);border:1.5px solid var(--line);border-radius:14px;padding:10px 8px 4px}
.chart .c{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;min-width:0}
.chart .c i{display:block;width:100%;background:var(--leaf);border-radius:4px 4px 0 0;min-height:2px}
.chart .c.sel i{background:var(--sun)}
.chart .c span{font-size:9px;color:var(--ink2);margin-top:2px}
.hrow{display:flex;justify-content:space-between;align-items:center;width:100%;text-align:left;background:var(--card);border:1.5px solid var(--line);border-radius:12px;padding:10px 14px;margin-top:8px}
.hrow.sel{border-color:var(--sun)}
.hrow .l{font-weight:700}
.hrow .wtag{font-size:12px;font-weight:600;color:var(--blue);margin-left:6px}
.hrow .r{color:var(--ink2);font-variant-numeric:tabular-nums;text-align:right;font-size:14px}
.jump{display:flex;gap:8px;align-items:center;margin:10px 0}
.jump input{border:1.5px solid var(--line);border-radius:10px;padding:6px 10px;background:var(--card);color:var(--ink);font:inherit}

.panel{background:var(--card);border:1.5px solid var(--line);border-radius:16px;padding:14px;margin-top:12px}
.panel h2{margin:0 0 8px;font-size:17px}
.panel h3{margin:14px 0 4px;font-size:14px;color:var(--leaf);border-bottom:1px solid var(--line);padding-bottom:4px}
.panel label{display:block;font-size:13px;color:var(--ink2);margin-top:8px}
.panel input[type=text],.panel input[type=password],.panel input[type=number],.panel select{width:100%;border:1.5px solid var(--line);border-radius:10px;padding:8px 10px;background:var(--paper);color:var(--ink);font:inherit}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.panel .btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.panel .btns button{border:1.5px solid var(--line);background:var(--paper);border-radius:10px;padding:8px 12px;font-size:13px}
.panel .btns button.pri{background:var(--ink);color:var(--paper);border-color:var(--ink);font-weight:700}
.panel .btns button.share{border-color:var(--blue);color:var(--blue);font-weight:700}
.note{font-size:12px;color:var(--ink2);margin-top:8px;line-height:1.5}
.hidden{display:none}
.foot{font-size:12px;color:var(--ink2);text-align:center;margin-top:22px}
@media (max-width:380px){.summary{grid-template-columns:1fr;justify-items:center}}
</style>
</head>
<body>
<div class="wrap">
  <div class="topbar">
    <div class="who" id="who"></div>
    <button class="iconbtn" id="btnSet" type="button">設定</button>
  </div>

  <div id="settings" class="panel hidden"></div>

  <div class="datebar">
    <h1 id="dateTitle"></h1>
    <div class="clock" id="clock"></div>
  </div>
  <div id="pastBanner"></div>

  <div id="summary"></div>
  <div id="slots"></div>

  <div class="hist">
    <h2>歷史紀錄（近 14 天熱量）</h2>
    <div id="chart"></div>
    <div class="jump"><span class="note" style="margin:0">跳到日期</span><input type="date" id="jumpDate"></div>
    <div id="histList"></div>
  </div>
  <div class="foot">熱量為 AI 估算值，僅供參考；份量與烹調方式會造成落差。</div>
</div>

<script>
"use strict";
/* ====== 基本設定 ====== */
var SLOTS = [
  {id:"breakfast", name:"早餐", icon:"🌅"},
  {id:"lunch",     name:"午餐", icon:"🍱"},
  {id:"dinner",    name:"晚餐", icon:"🍲"},
  {id:"snack",     name:"點心", icon:"🍪"},
  {id:"night",     name:"宵夜", icon:"🌙"},
  {id:"drink",     name:"飲料", icon:"🧋"}
];
var STORE_KEY = "cal_tracker_v2";
var OLD_STORE_KEY = "cal_tracker_v1";
var KEY_API = "cal_tracker_apikey";
var KEY_MODEL = "cal_tracker_model";
var DEFAULT_MODEL = "claude-sonnet-4-20250514";

/* ====== 台灣時間 ====== */
var fmtDate = new Intl.DateTimeFormat("en-CA",{timeZone:"Asia/Taipei",year:"numeric",month:"2-digit",day:"2-digit"});
var fmtTime = new Intl.DateTimeFormat("zh-TW",{timeZone:"Asia/Taipei",hour:"2-digit",minute:"2-digit",hour12:false});
var fmtHour = new Intl.DateTimeFormat("en-US",{timeZone:"Asia/Taipei",hour:"numeric",hour12:false});
var fmtWeek = new Intl.DateTimeFormat("zh-TW",{timeZone:"Asia/Taipei",weekday:"long"});
function twToday(){ return fmtDate.format(new Date()); }
function twTime(){ return fmtTime.format(new Date()); }
function twHour(){ var h = parseInt(fmtHour.format(new Date()),10); return h===24?0:h; }
function weekdayOf(ds){ return fmtWeek.format(new Date(ds+"T12:00:00+08:00")); }
function nowSlot(){
  var h = twHour();
  if(h>=5 && h<10) return "breakfast";
  if(h>=10 && h<14) return "lunch";
  if(h>=14 && h<17) return "snack";
  if(h>=17 && h<21) return "dinner";
  return "night";
}

/* ====== URL Hash 自動匯入設定（安全不經過伺服器） ====== */
(function checkHashSetup(){
  if(!location.hash || location.hash.length < 2) return;
  try{
    var params = new URLSearchParams(location.hash.slice(1));
    var k = params.get("key");
    var who = params.get("who");
    var imported = false;
    if(k && k.startsWith("sk-")){
      localStorage.setItem(KEY_API, k.trim());
      imported = true;
    }
    if(who === "a" || who === "b"){
      var raw = localStorage.getItem(STORE_KEY);
      var obj = raw ? JSON.parse(raw) : null;
      if(obj && obj.profiles){ obj.current = who; localStorage.setItem(STORE_KEY, JSON.stringify(obj)); }
      else { sessionStorage.setItem("init_who", who); }
      imported = true;
    }
    if(imported){
      history.replaceState(null, "", location.pathname + location.search);
      setTimeout(function(){ alert("已自動完成 API 金鑰與個人模式設定！"); }, 200);
    }
  }catch(e){}
})();

/* ====== 資料與相容升級 ====== */
function defaultStore(){
  var initWho = sessionStorage.getItem("init_who") || "a";
  return {current:initWho, profiles:{
    a:{name:"我", goal:"cut", target:1500, proTarget:95, days:{}, weights:{}},
    b:{name:"先生", goal:"bulk", target:2500, proTarget:130, days:{}, weights:{}}
  }};
}
function load(){
  try{
    var raw = localStorage.getItem(STORE_KEY) || localStorage.getItem(OLD_STORE_KEY);
    if(raw){
      var s = JSON.parse(raw);
      if(s && s.profiles && s.profiles.a && s.profiles.b){
        // 補齊新版欄位
        if(!s.profiles.a.goal) s.profiles.a.goal = "cut";
        if(!s.profiles.b.goal) s.profiles.b.goal = "bulk";
        if(!s.profiles.a.proTarget) s.profiles.a.proTarget = 95;
        if(!s.profiles.b.proTarget) s.profiles.b.proTarget = 130;
        if(!s.profiles.a.weights) s.profiles.a.weights = {};
        if(!s.profiles.b.weights) s.profiles.b.weights = {};
        var initWho = sessionStorage.getItem("init_who");
        if(initWho === "a" || initWho === "b"){ s.current = initWho; sessionStorage.removeItem("init_who"); }
        return s;
      }
    }
  }catch(e){}
  return defaultStore();
}
var S = load();

/* 自動清理超過 30 天的舊縮圖（保留所有熱量與文字數據，防止 localStorage 5MB 爆滿） */
(function pruneOldThumbs(){
  var cutoff = fmtDate.format(new Date(Date.now() - 30 * 86400000));
  var changed = false;
  ["a","b"].forEach(function(k){
    var days = S.profiles[k].days || {};
    Object.keys(days).forEach(function(d){
      if(d < cutoff){
        days[d].forEach(function(e){ if(e.thumb){ e.thumb = ""; changed = true; } });
      }
    });
  });
  if(changed){ try{ localStorage.setItem(STORE_KEY, JSON.stringify(S)); }catch(e){} }
})();

var saveWarned = false;
function save(){
  try{ localStorage.setItem(STORE_KEY, JSON.stringify(S)); }
  catch(e){
    if(!saveWarned){ saveWarned = true; alert("瀏覽器儲存空間已滿，新紀錄可能無法保存。請到「設定」匯出備份，並清除較舊的資料。"); }
  }
}
function P(){ return S.profiles[S.current]; }
function dayEntries(ds){ return (P().days[ds] || []); }
function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];}); }
function num(x){ x = Number(x); return isFinite(x)?x:0; }
function round(x){ return Math.round(num(x)); }
function totals(entries){
  var t={kcal:0,p:0,c:0,f:0};
  entries.forEach(function(e){ t.kcal+=num(e.kcal); t.p+=num(e.p); t.c+=num(e.c); t.f+=num(e.f); });
  return t;
}

/* ====== 狀態 ====== */
var todayStr = twToday();
var viewDate = todayStr;
var drafts = {};
SLOTS.forEach(function(s){ drafts[s.id] = {text:"", img:null, busy:false, err:""}; });
var openSlots = {}; openSlots[nowSlot()] = true;
var settingsOpen = false;

/* ====== 畫面 ====== */
function renderWho(){
  var h = "";
  ["a","b"].forEach(function(k){
    var prof = S.profiles[k];
    var isCut = prof.goal !== "bulk";
    h += '<button type="button" data-who="'+k+'" class="'+(S.current===k?"on":"")+'">'+
         esc(prof.name)+'<span class="badge '+(isCut?'cut':'bulk')+'">'+(isCut?'減脂':'增重')+'</span></button>';
  });
  document.getElementById("who").innerHTML = h;
}
function renderDate(){
  var d = viewDate;
  document.getElementById("dateTitle").textContent = d.replace(/-/g,"/")+" "+weekdayOf(d);
  document.getElementById("clock").textContent = "台灣時間 "+twTime();
  var pb = document.getElementById("pastBanner");
  if(viewDate!==todayStr){
    pb.innerHTML = '<div class="pastbanner"><span>正在查看過去紀錄，仍可補記。</span><button type="button" id="btnToday">回到今天</button></div>';
  } else pb.innerHTML = "";
}
function ringSvg(pct, status){
  var r=58, c=2*Math.PI*r, off=c*(1-Math.min(pct,1));
  var col = status==="over" ? "var(--warn)" : (status==="under" ? "var(--sun)" : "var(--leaf)");
  return '<svg viewBox="0 0 136 136"><circle cx="68" cy="68" r="'+r+'" fill="none" stroke="var(--line)" stroke-width="12"/>'+
    '<circle cx="68" cy="68" r="'+r+'" fill="none" stroke="'+col+'" stroke-width="12" stroke-linecap="round" stroke-dasharray="'+c.toFixed(1)+'" stroke-dashoffset="'+off.toFixed(1)+'"/></svg>';
}
function renderSummary(){
  var prof = P(), isCut = prof.goal !== "bulk";
  var t = totals(dayEntries(viewDate)), tg = num(prof.target) || (isCut?1500:2500);
  var proTg = num(prof.proTarget) || (isCut?95:130);
  var pct = t.kcal/tg, diff = tg - t.kcal;
  var status = "ok", tgtLine = "";

  if(isCut){
    if(t.kcal > tg){ status = "over"; tgtLine = '<span class="over">已超過減脂上限 '+round(-diff)+' 大卡</span>'; }
    else { status = "ok"; tgtLine = '<span class="ok">減脂安全區內，還可吃 '+round(diff)+' 大卡</span>'; }
  } else {
    if(t.kcal < tg){ status = "under"; tgtLine = '<span class="under">增重未達標，還差 '+round(diff)+' 大卡！</span>'; }
    else { status = "ok"; tgtLine = '<span class="ok">增重熱量已達標（+'+round(-diff)+' 大卡）</span>'; }
  }

  var pg = t.p*4, cg = t.c*4, fg = t.f*9, sum = pg+cg+fg || 1;
  var proPct = Math.min(100, Math.round(t.p / proTg * 100));
  var wVal = (prof.weights && prof.weights[viewDate]) ? prof.weights[viewDate] : "";

  document.getElementById("summary").innerHTML =
    '<div class="summary-wrap"><div class="summary">'+
      '<div class="ring">'+ringSvg(pct,status)+'<div class="num"><div class="big">'+round(t.kcal)+'</div><div class="sub">大卡 / '+tg+'</div></div></div>'+
      '<div class="macros">'+
        '<div class="macro"><div class="row"><span><b>蛋白質（目標 '+proTg+'g）</b></span><span><b>'+round(t.p)+' / '+proTg+' g</b></span></div><div class="bar pro"><i style="width:'+proPct+'%"></i></div></div>'+
        '<div class="macro"><div class="row"><span>碳水化合物</span><span>'+round(t.c)+' g</span></div><div class="bar"><i style="width:'+Math.min(100,Math.round(cg/sum*100))+'%"></i></div></div>'+
        '<div class="macro"><div class="row"><span>脂肪</span><span>'+round(t.f)+' g</span></div><div class="bar"><i style="width:'+Math.min(100,Math.round(fg/sum*100))+'%"></i></div></div>'+
        '<div class="tgt">'+tgtLine+'</div>'+
      '</div>'+
    '</div>'+
    '<div class="weight-bar"><span>⚖️ 當天體重紀錄（選填）</span><div class="w-in"><input type="number" step="0.1" id="dayWeight" placeholder="kg" value="'+esc(wVal)+'"><button type="button" id="saveWeight">儲存</button></div></div>'+
    '</div>';
}
function entryHtml(e){
  var isBulk = P().goal === "bulk";
  var otherName = S.profiles[S.current==="a"?"b":"a"].name;
  var items = (e.items||[]).map(function(it){
    return '<li><span>'+esc(it.name)+(it.portion?'（'+esc(it.portion)+'）':'')+'</span><span>'+round(it.kcal)+'</span></li>';
